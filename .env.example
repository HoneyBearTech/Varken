# Settings for docker-compose.yml. Copy to .env (never commit it) and edit.
# Every VRKN_* variable overrides the same key in /config/varken.ini (created from varken.example.ini on first
# start); docs/configuration.md lists them all. Values here are placeholders.

# --- Compose -------------------------------------------------------------------------------------------------
# Image tag (a release such as 2.0.0, or latest).
VARKEN_VERSION=latest
# Where app data lives on the host: Varken keeps varken.ini, the GeoLite2 database and logs in
# CONFIG_ROOT/varken/config, which must belong to VARKEN_UID:VARKEN_GID. Never inside /var/lib/docker/volumes.
CONFIG_ROOT=/srv/config
VARKEN_UID=1000
VARKEN_GID=1000
# Where the /metrics port is published on the host. Keep it on a loopback or private address.
VARKEN_METRICS_BIND=127.0.0.1:9180
TZ=UTC

# --- Which services to collect from: comma-separated server ids, or false ------------------------------------
VRKN_GLOBAL_TAUTULLI_SERVER_IDS=1
VRKN_GLOBAL_SONARR_SERVER_IDS=false
VRKN_GLOBAL_RADARR_SERVER_IDS=false
VRKN_GLOBAL_LIDARR_SERVER_IDS=false
VRKN_GLOBAL_OMBI_SERVER_IDS=false
VRKN_GLOBAL_SICKCHILL_SERVER_IDS=false
VRKN_GLOBAL_UNIFI_SERVER_IDS=false
# For Tautulli's GeoIP locations (free account at maxmind.com): a license key and the account ID it belongs to.
# Leave the key empty to turn GeoIP off: streams then have no location, and Varken never contacts MaxMind.
VRKN_GLOBAL_MAXMIND_LICENSE_KEY=
VRKN_GLOBAL_MAXMIND_ACCOUNT_ID=

# Also log to logs/varken.log in CONFIG_ROOT/varken/config; false logs to stdout (docker logs) only.
LOG_TO_FILE=true

# --- Prometheus /metrics -------------------------------------------------------------------------------------
VRKN_PROMETHEUS_BIND=0.0.0.0
VRKN_PROMETHEUS_PORT=9180
# true adds who is watching what, and from which city, to the metrics. Off by default.
VRKN_PROMETHEUS_STREAM_DETAILS=false

# --- Tautulli server 1 ---------------------------------------------------------------------------------------
# host[:port], without http(s)://; set SSL=true for https.
VRKN_TAUTULLI_1_URL=tautulli.example.com:8181
VRKN_TAUTULLI_1_APIKEY=replace-me
# Or read it from a file (Docker/compose secrets); any VRKN_* setting takes _FILE the same way:
# VRKN_TAUTULLI_1_APIKEY_FILE=/run/secrets/tautulli_api_key
VRKN_TAUTULLI_1_SSL=false
VRKN_TAUTULLI_1_VERIFY_SSL=false
# Public IP used for GeoIP when a stream comes from your LAN.
VRKN_TAUTULLI_1_FALLBACK_IP=1.1.1.1
VRKN_TAUTULLI_1_GET_ACTIVITY=true
VRKN_TAUTULLI_1_GET_ACTIVITY_RUN_SECONDS=30
VRKN_TAUTULLI_1_GET_STATS=true
VRKN_TAUTULLI_1_GET_STATS_RUN_SECONDS=3600

# Sonarr, Radarr, Lidarr, Ombi, SickChill and UniFi follow the same pattern (VRKN_SONARR_1_URL, ...);
# see docs/configuration.md.
