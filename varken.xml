<?xml version="1.0"?>
<Container version="2">
  <Name>Varken</Name>
  <Repository>ghcr.io/honeybeartech/varken</Repository>
  <Registry>https://github.com/HoneyBearTech/Varken/pkgs/container/varken</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/HoneyBearTech/Varken/issues</Support>
  <Project>https://github.com/HoneyBearTech/Varken</Project>
  <Overview>
    Varken collects data from the Plex ecosystem and serves it as Prometheus metrics on port 9180.
  </Overview>
  <Category/>
  <WebUI/>
  <TemplateURL/>
  <Icon>Pig.png</Icon>
  <ExtraParams>--user 99:100</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Description>
    Varken collects data from the Plex ecosystem and serves it as Prometheus metrics on port 9180.
  </Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>9180</HostPort>
        <ContainerPort>9180</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/varken</HostDir>
      <ContainerDir>/config</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment/>
  <Labels/>
  <Config Name="Varken DataDir" Target="/config" Default="" Mode="rw" Description="Container Path: /config" Type="Path" Display="advanced-hide" Required="true" Mask="false">/mnt/user/appdata/varken</Config>
</Container>