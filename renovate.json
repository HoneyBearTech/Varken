{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate proposes every dependency update and merges it once every required check on the pull request has passed (docs/dependencies.md). platformAutomerge is off, so Renovate merges by itself on its next run instead of asking GitHub to; a new version waits three days after its release (minimumReleaseAge), and fixes for vulnerability alerts skip the wait by Renovate's default. timestamp-optional lets an update from a registry that reports no release date through. See https://docs.renovatebot.com/configuration-options/#minimumreleaseage",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "gitlabci",
    "github-actions",
    "pip_requirements",
    "custom.regex"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements(?:-[^/]+)?\\.(?:in|txt)$/"
    ]
  },
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "America/Chicago",
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor and patch dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "addLabels": [
        "major"
      ]
    },
    {
      "description": "An image rebuild (a new digest under the same tag) doesn't wait: Docker Hub dates a rebuild by the tag's last push, so a tag rebuilt about weekly would restart the clock each time and never clear the wait.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Keep the fuzz runtime on Python 3.14 until its pinned dependencies support 3.15.",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/fuzz.yml"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "3.14"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.env\\.example$/"
      ],
      "matchStrings": [
        "(?:^|\\n)VARKEN_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/honeybeartech/varken"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker\\-compose\\.yml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/honeybeartech/varken:\\$\\{VARKEN_VERSION:-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\}"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/honeybeartech/varken"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^varken\\.xml$/"
      ],
      "matchStrings": [
        "<Repository>ghcr\\.io/honeybeartech/varken:(?<currentValue>\\d+\\.\\d+\\.\\d+)</Repository>"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/honeybeartech/varken"
    }
  ]
}
